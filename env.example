# Server Configuration

NODE_ENV=development
# Use 5001 on macOS — port 5000 is reserved by AirPlay Receiver (Control Center)
PORT=5001

# Database
MONGO_URI=mongodb://localhost:27017/leafymap
# PostgreSQL (Prisma — announcements CMS). Start with: docker compose up -d
DATABASE_URL=postgresql://leafymap:leafymap@localhost:5432/leafymap?schema=public

# Redis (optional cache). If missing or down, the API falls back to Mongo.
# Docker compose: redis://redis:6379  |  host: redis://localhost:6379
# Upstash / managed Redis with TLS: rediss://default:PASSWORD@HOST:6379
REDIS_URL=redis://localhost:6379

# Mapbox Geocoding (server-side proxy). Tiles still use NEXT_PUBLIC_MAPBOX_TOKEN on the frontend.
# If missing or Mapbox is down, suggest/reverse return empty results.
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key

# AWS S3 Configuration
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_s3_bucket_name

# CORS and email links are hardcoded in src/shared/constants/common.ts.
# ALLOWED_ORIGINS and FRONTEND_URL are not read.
# Production origins: https://leafymap.com and https://www.leafymap.com
# Production email links: https://leafymap.com
# JWT expiry is fixed to 1d (JWT_EXPIRE is not read).
# Google sign-in only needs GOOGLE_CLIENT_ID (GOOGLE_CLIENT_SECRET is not read).

# Email (Brevo - 300 emails/jour gratuits, même config en dev et en prod)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre_email_brevo
SMTP_PASS=votre_cle_smtp_brevo
MAIL_FROM=noreply@votredomaine.com

# Google OAuth (same Client ID as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Seed ecosystem (optional). Shared password for @leafymap.seed users.
# SEED_USER_PASSWORD=SeedUser!2026
