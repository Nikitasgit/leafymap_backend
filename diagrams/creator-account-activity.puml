@startuml
!pragma layout smetana
!pragma useVerticalIf off

skinparam shadowing false
skinparam activityBackgroundColor #FEFECE
skinparam activityBorderColor #A80036

|Utilisateur|
start
:Remplir le formulaire\nprofil creator;
-right->

|Système|
if (Utilisateur connecté\net guest ?) then (non)
  :Refuser;
  stop
else (oui)
endif

:Valider les données\n(newCreatorSchema);

if (Données invalides ?) then (oui)
  :Retourner erreur;
  stop
else (non)
endif

:Mettre à jour le compte\n(userType = creator);
:Générer un nouveau token\navec le userType creator;

if (Création d'un lieu\ndemandée ?) then (oui)
  :Créer le lieu associé au compte\n(appel API séparé);
else (non)
endif

:Retourner succès;
stop

@enduml
